<div class="project-list-item">
  <a href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    {% if project.img %}
      {%
        include figure.liquid
        loading="eager"
        path=project.img
        sizes="64px"
        alt="project thumbnail"
        class="project-thumb"
        width="64"
        height="64"
      %}
    {% endif %}
    <h2 class="project-title">{{ project.title }}</h2>
  </a>
</div>
